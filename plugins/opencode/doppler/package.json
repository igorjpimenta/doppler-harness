{
  "name": "@igorjpimenta/doppler-opencode",
  "version": "2026.11.4-beta.1",
  "description": "OpenCode bridge for doppler-harness: the entry (setup + legacy server), the plugin loader, and the engine self-update.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorjpimenta/doppler-harness.git",
    "directory": "plugins/opencode/doppler"
  },
