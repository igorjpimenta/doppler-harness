# Machine state this repo's tooling writes beside the checkout.
.doppler/

# Dependencies and build output. dist/ is regenerated by npm prepare and is
# never edited by hand. Bare name, no slash: worktrees have been known to share
# the checkout's node_modules by symlink, and a trailing slash ignores
# directories only — the link itself would slip through.
node_modules
dist/

# npm pack output: an artifact of cutting a release, not source.
*.tgz

# The package ships no dependencies, so a lockfile would pin nothing.
package-lock.json

# OS noise.
**/.DS_Store
