{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    // Off deliberately: the splicer indexes into text character by character, so
    // under this flag every `s[i]` is `string | undefined` and the noise buries
    // the errors that matter. The index is in range by construction.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    // Node strips types, it does not transform them: an enum or a parameter
    // property would pass tsc and fail at load. This forbids exactly that class,
    // and it is also what makes the emitted dist a pure type-erasure of the
    // source — no downleveling, no helpers, nothing to review beyond the diff.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Relative imports may name the .ts file they come from, and the build
    // rewrites the extension: the source is checked as written, and the emitted
    // JavaScript imports the .js next to it. Without this a shared module
    // would have to be duplicated into every entry that uses it, because the
    // source-mode test runner resolves a .js specifier to a file that does
    // not exist.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Build output. The .ts is the checked source; dist/doppler.mjs is what
    // ships, because the desktop app's server runs under Node and Node refuses
    // to strip types for a file under node_modules. Bun (the TUI/CLI) would
    // load the .ts fine — dist exists so both runtimes load the same file.
    "noEmit": false,
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["opencode"],
  "exclude": ["node_modules"]
}
