{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    // Off deliberately: this package is a character-level text splicer, so
    // every `s[i]` is `string | undefined` under this flag and the noise buries
    // the errors that matter. The index is in range by construction here.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["bin", "opencode", "test"],
  "exclude": ["node_modules"]
}
