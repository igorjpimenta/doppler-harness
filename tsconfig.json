{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    // Off deliberately: the splicer indexes into text character by character, so
    // under this flag every `s[i]` is `string | undefined` and the noise buries
    // the errors that matter. The index is in range by construction.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    // Node strips types, it does not transform them: an enum or a parameter
    // property would pass tsc and fail at load. This forbids exactly that class.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["opencode"],
  "exclude": ["node_modules"]
}
